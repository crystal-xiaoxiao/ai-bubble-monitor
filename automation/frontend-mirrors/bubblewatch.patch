+// Snapshot freshness is authoritative; older snapshots retain their original date-based tags.
+function indicatorFreshness(ind, issueDate) {
+  if (ind.freshness === 'new') return { stale: false, tag: '' };
+  if (ind.freshness === 'current') {
+    return { stale: false, tag: ' <span class="current-tag">Latest filing</span>' };
+  }
+  if (ind.freshness === 'stale') return { stale: true, tag: '' };
+  const carried = !ind.stale && ind.as_of && issueDate && ind.as_of < issueDate;
+  return {
+    stale: Boolean(ind.stale),
+    tag: carried ? ' <span class="carry-tag">CARRIED</span>' : ''
+  };
 }
 
